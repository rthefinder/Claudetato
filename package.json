{
  "name": "claudetato",
  "version": "0.1.0",
  "description": "Claude Potato: An AI-guided potato growth experiment on Solana",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "node --loader tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src tests scripts --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "simulate-epoch": "node --loader tsx scripts/simulate-epoch.ts",
    "compute-health": "node --loader tsx scripts/compute-potato-health.ts",
    "snapshot-balances": "node --loader tsx scripts/snapshot-balances.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist build coverage .nyc_output"
  },
  "keywords": [
    "solana",
    "blockchain",
    "experiment",
    "potato",
    "ai",
    "dex"
  ],
  "author": "Claude Potato Project",
  "license": "MIT",
  "dependencies": {
    "@solana/spl-token": "^0.3.10",
    "@solana/web3.js": "^1.95.0",
    "dotenv": "^16.4.5",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/ui": "^1.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
