# Solana Network Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# Experiment Configuration
EXPERIMENT_MODE=dry-run
SENSOR_SOURCE=mock
EPOCH_INTERVAL_MINUTES=30
POTATO_HEALTH_FORMULA=v1

# Fee Tracking (required)
FEE_WALLET=11111111111111111111111111111112
FEE_TOKEN_MINT=11111111111111111111111111111112

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Risk Management
MAX_SPEND_PER_EPOCH_LAMPORTS=1000000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
DEX_PREFERENCE=mock

# Optional: Sensor Configuration
# SENSOR_FILE_PATH=./data/sensors.json
# SENSOR_API_URL=http://localhost:3000

# Optional: Alerts
# WEBHOOK_URL=
# SLACK_WEBHOOK=
# EMAIL_ALERTS=disabled
